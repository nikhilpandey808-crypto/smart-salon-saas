generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SalonRole {
  OWNER
  ADMIN
  STAFF
}

enum AppointmentStatus {
  UPCOMING
  COMPLETED
  CANCELLED
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  memberships  SalonMember[]
}

model Salon {
  id           String        @id @default(cuid())
  name         String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  memberships  SalonMember[]
  customers    Customer[]
  staff        StaffMember[]
  services     Service[]
  appointments Appointment[]
}

model SalonMember {
  id        String    @id @default(cuid())
  salonId   String
  userId    String
  role      SalonRole @default(STAFF)
  createdAt DateTime  @default(now())
  salon     Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([salonId, userId])
  @@index([userId])
}

model Customer {
  id           String        @id @default(cuid())
  salonId      String
  name         String
  email        String?
  phone        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  salon        Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([salonId, name])
}

model StaffMember {
  id           String        @id @default(cuid())
  salonId      String
  name         String
  role         String        @default("Stylist")
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  salon        Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([salonId, name])
  @@index([salonId, active])
}

model Service {
  id                String        @id @default(cuid())
  salonId           String
  name              String
  durationMinutes   Int           @default(60)
  priceCents        Int           @default(0)
  active            Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  salon             Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  appointments      Appointment[]

  @@unique([salonId, name])
  @@index([salonId, active])
}

model Appointment {
  id          String            @id @default(cuid())
  salonId     String
  customerId  String
  staffId     String
  serviceId   String
  startsAt    DateTime
  endsAt      DateTime
  amountCents Int
  status      AppointmentStatus @default(UPCOMING)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  salon       Salon             @relation(fields: [salonId], references: [id], onDelete: Cascade)
  customer    Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  staff       StaffMember       @relation(fields: [staffId], references: [id], onDelete: Restrict)
  service     Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([salonId, startsAt])
  @@index([staffId, startsAt])
}
